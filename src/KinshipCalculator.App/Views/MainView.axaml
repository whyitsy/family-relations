<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KinshipCalculator.App.ViewModels"
             xmlns:models="using:KinshipCalculator.Core.Models"
             xmlns:views="using:KinshipCalculator.App.Views"
             x:Class="KinshipCalculator.App.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Grid ColumnDefinitions="260,*,360" RowDefinitions="Auto,Auto,*">

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="12,10">
            <TextBlock Text="亲戚关系计算器" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="新增成员" Command="{Binding AddPersonCommand}" />
            <Button Content="删除成员" Command="{Binding DeletePersonCommand}" />
            <Button Content="设为『我』" Command="{Binding SetSelfCommand}" />
            <TextBlock Text="{Binding SelfLabel}" VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.8" />
        </StackPanel>

        <!-- 数据传递工具栏 -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="12,0,12,8">
            <TextBlock Text="数据传递：" VerticalAlignment="Center" Opacity="0.7" />
            <Button Content="导出 JSON 文件" Click="OnExportFile" />
            <Button Content="复制 JSON" Click="OnCopyText" />
            <Button Content="导入 JSON 文件" Click="OnImportFile" />
            <Button Content="粘贴导入" Click="OnPasteImport" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Opacity="0.8"
                       TextTrimming="CharacterEllipsis" MaxWidth="380" />
        </StackPanel>

        <!-- 左：成员列表 -->
        <ListBox Grid.Row="2" Grid.Column="0" Margin="12,0,8,12"
                 ItemsSource="{Binding People}"
                 SelectedItem="{Binding SelectedPerson, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Person">
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 中：关系图谱 -->
        <views:GraphCanvas Grid.Row="2" Grid.Column="1" x:Name="Graph" Margin="0,0,8,12" />

        <!-- 右：详情编辑 + 称谓结果 -->
        <Grid Grid.Row="2" Grid.Column="2" RowDefinitions="Auto,*" Margin="0,0,12,12">

            <!-- 成员详情 -->
            <StackPanel Grid.Row="0" Spacing="6" IsEnabled="{Binding HasSelection}">
                <TextBlock Text="成员详情" FontWeight="SemiBold" />

                <Grid ColumnDefinitions="56,*">
                    <TextBlock Text="姓名" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SelectedName, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="56,*">
                    <TextBlock Text="性别" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedGenderIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="男" />
                        <ComboBoxItem Content="女" />
                        <ComboBoxItem Content="未知" />
                    </ComboBox>
                </Grid>

                <Grid ColumnDefinitions="56,*">
                    <TextBlock Text="生日" VerticalAlignment="Center" />
                    <DatePicker Grid.Column="1" SelectedDate="{Binding SelectedBirthDate, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="56,*">
                    <TextBlock Text="备注" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SelectedNotes, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="56,*,Auto">
                    <TextBlock Text="父亲" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding People}"
                              SelectedItem="{Binding SelectedFather, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Person">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Content="清除" Command="{Binding ClearFatherCommand}" />
                </Grid>

                <Grid ColumnDefinitions="56,*,Auto">
                    <TextBlock Text="母亲" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding People}"
                              SelectedItem="{Binding SelectedMother, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Person">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Content="清除" Command="{Binding ClearMotherCommand}" />
                </Grid>

                <Grid ColumnDefinitions="56,*,Auto">
                    <TextBlock Text="配偶" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding People}"
                              SelectedItem="{Binding SelectedSpouse, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Person">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Content="清除" Command="{Binding ClearSpouseCommand}" />
                </Grid>

                <TextBlock Text="提示：兄弟姐妹与子女会按父/母自动推导。" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 称谓结果 -->
            <ListBox Grid.Row="1" Margin="0,10,0,0"
                     ItemsSource="{Binding KinshipResults}"
                     SelectedItem="{Binding SelectedResult, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:KinshipResultRow">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Summary}" />
                            <TextBlock Text="{Binding Path}" FontSize="11" Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
