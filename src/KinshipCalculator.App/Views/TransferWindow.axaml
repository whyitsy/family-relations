<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:KinshipCalculator.App.Views"
        x:Class="KinshipCalculator.App.Views.TransferWindow"
        Width="560"
        Height="680"
        MinWidth="420"
        MinHeight="520"
        Title="光学发送"
        Background="#1E1E1E">
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="12">
            <Button x:Name="StartStopButton" Content="开始发送" Click="OnStartStop" />
            <TextBlock Text="屏幕显示二维码流，另一台设备用摄像头扫描接收"
                       VerticalAlignment="Center" Foreground="White" Opacity="0.8" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" Margin="12" CornerRadius="4">
            <views:QrCanvas x:Name="QrView" Margin="12" />
        </Border>

        <TextBlock Grid.Row="2" x:Name="StatusText" Margin="12,0,12,12"
                   Foreground="White" Opacity="0.8" TextWrapping="Wrap" />
    </Grid>
</Window>
