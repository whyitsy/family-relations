<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KinshipCalculator.App.App"
             RequestedThemeVariant="Default">
    <!-- "Default" 跟随系统深浅色；"Light"/"Dark" 亦可 -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
