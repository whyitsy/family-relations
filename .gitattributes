# Normalize line endings: store LF in the repository,
# check out native (CRLF on Windows, LF elsewhere).
* text=auto

# Explicit source/text files -> LF in repo
*.cs          text eol=lf
*.csproj      text eol=lf
*.sln         text eol=lf
*.slnx        text eol=lf
*.props       text eol=lf
*.targets     text eol=lf
*.axaml       text eol=lf
*.xaml        text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.txt         text eol=lf
*.xml         text eol=lf
*.plist       text eol=lf
*.manifest    text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.gitignore   text eol=lf
*.gitattributes text eol=lf
*.sh          text eol=lf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.pdf   binary
*.snk   binary
*.pfx   binary
